<!-- File: android/app/src/main/res/layout/next_prayer_widget.xml -->
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/next_prayer_widget_background"
    android:orientation="vertical"
    android:padding="16dp"
    android:clickable="true">

    <!-- Header with date and location -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_location"
            android:tint="#A19CC5" />

        <TextView
            android:id="@+id/widget_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Loading..."
            android:textColor="#A19CC5"
            android:textSize="11sp"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dec 25, 2024"
            android:textColor="#A19CC5"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Next Prayer Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Next Prayer"
        android:textColor="#A44AFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/category_background"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:layout_marginBottom="12dp" />

    <!-- Main Prayer Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Prayer Icon -->
        <ImageView
            android:id="@+id/widget_prayer_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_prayer_default"
            android:tint="#A44AFF"
            android:layout_marginEnd="16dp" />

        <!-- Prayer Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_next_prayer_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fajr"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/widget_next_prayer_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="05:30"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginBottom="2dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Time Remaining -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_timer"
            android:tint="#A44AFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="in "
            android:textColor="#A19CC5"
            android:textSize="12sp"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/widget_time_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2h 15m"
            android:textColor="#A44AFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>